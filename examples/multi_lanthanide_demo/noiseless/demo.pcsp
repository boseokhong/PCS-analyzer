[fitting]
mode = theta_alpha_multi
selected_proton_ids =
selected_donor_ids =
axis_mode = bisector
fit_visible_as_group = true
fit_dchi_ax = false
fit_dchi_rh = false
use_global_search = false
use_current_tensor = false
weighting_mode = unweighted

[fit_override]
enabled = false
mode = none

[fit_history]
format =

[last_fit_result]
available = false

[conformer_search]
applied = false
constraint_mode = angular
last_rmsd =
last_q_factor =
last_n_clashes =

[viewer.pcs_field]
spacing = 0.35
padding = auto
r_mask_min = 0.8
clip_abs_ppm = none
show_slices = false
show_isosurfaces = true
show_labels = false
show_atoms = true
show_bonds = true
slice_opacity = 0.25
background = white
ambient_light = 0.3

[viewer.pcs_field.levels]
# ppm pos_color neg_color style opacity

[viewer.plot3d]
color_mode = Element
show_labels = false

[viewer.projection]
mode = phi_cos_theta
fixed_r = 10.0
show_atoms = true
show_h = true

[export]
default_dpi = 600
