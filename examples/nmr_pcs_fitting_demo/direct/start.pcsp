[symmetry_averaging]
enabled = false
methyl_enabled = true
cf3_enabled = true
keep_original = false
mode = drop

[rotational_averaging]
enabled = false
detection_mode = auto
keep_reference = false
planarity_threshold = 0.1
phase = 2

[rotational_groups]
# One JSON object per configured torsional group

[visibility]
selected_elements = H,N,Nd
selected_ligands_json = ["refs:2"]
residual_color_enabled = false
residual_thr_ok = 0.1
residual_thr_warn = 0.3

[pcs_model]
dchi_ax = 10.0
dchi_rh = 2.0
rhombic_enabled = true
prediction_model = full_tensor
pcs_min = -10.0
pcs_max = 10.0
pcs_interval = 0.5
plot_90 = false

[rotation]
x = 0.0
y = 0.0
z = 0.0
euler_order = XYZ

[delta_exp]
# ref ppm

[delta_obs]
# ref ppm

[delta_dia]
# ref ppm

[experimental_pcs]
format = structured_v1
observations_json = []

[multi_conformer]
payload_json = {"format":"pcs_multiconformer_v1","schema_version":1,"conformers":[],"options":{"target":"both","fit_ax":true,"fit_rh":false,"dchi_ax":-2.0,"dchi_rh":0.0,"weighting":"unweighted","alignment":"confirmed_common_frame","core_ids":[],"observation_ids":null,"initialization":"user","starts":8,"seed":0},"last_result":null}

[joint_pcs_rdc]
payload_json = {"format":"joint_pcs_rdc_project","schema_version":1,"rdc_rows":[],"options":{"B0":14.1,"T":298.0,"w_rdc":1.0,"use_pcs_errors":false,"observation_ids":null},"last_result":null}

[pre_fitting]
payload_json = {"format":"pre_project","schema_version":1,"rows":[],"options":{"B0":14.1,"mu_eff":3.68,"preset":"Nd","use_errors":false,"tau_min_ns":0.001,"tau_max_ns":1000.0},"last_result":null}

[multi_lanthanide]
payload_json = {"schema_version":1,"datasets":[],"options":{"mode":"tensor","temperature":300.0,"method":"direct","use_errors":false,"reference_ln":"Nd","nucleus_i":"","nucleus_j":"","nucleus_c":""},"results":{}}

[fitting]
mode = euler_global
selected_proton_ids =
selected_donor_ids =
axis_mode = first
fit_visible_as_group = true
fit_dchi_ax = true
fit_dchi_rh = true
use_global_search = false
use_current_tensor = false
weighting_mode = unweighted

[fit_override]
enabled = false
mode = none

[fit_history]
format =

[last_fit_result]
available = false

[conformer_search]
applied = false
constraint_mode = angular
last_rmsd =
last_q_factor =
last_n_clashes =

[viewer.pcs_field]
spacing = 0.35
padding = auto
r_mask_min = 0.8
clip_abs_ppm = none
show_slices = false
show_isosurfaces = true
show_labels = false
show_atoms = true
show_bonds = true
slice_opacity = 0.25
background = white
ambient_light = 0.3

[viewer.pcs_field.levels]
# ppm pos_color neg_color style opacity

[viewer.plot3d]
color_mode = Element
show_labels = false

[viewer.projection]
mode = phi_cos_theta
fixed_r = 10.0
show_atoms = true
show_h = true

[export]
default_dpi = 600
