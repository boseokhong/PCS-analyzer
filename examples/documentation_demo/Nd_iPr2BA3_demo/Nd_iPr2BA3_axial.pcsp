{"group_id":"rot2","label":"Phenyl-like","axis_atoms":[40,42],"rotating_atoms":[42,44,46,48,50,52,54,56,58,60,62],"ring_atoms":[42,44,48,52,56,60],"ring_cycles":[[42,44,48,52,56,60]],"source":"auto","enabled":true,"range_mode":"full","range_start_deg":0.0,"range_end_deg":360.0,"n_samples":24,"weight_mode":"uniform","planarity_rms":0.0021992073811005716}
{"group_id":"rot3","label":"Phenyl-like","axis_atoms":[41,43],"rotating_atoms":[43,45,47,49,51,53,55,57,59,61,63],"ring_atoms":[43,45,49,53,57,61],"ring_cycles":[[43,45,49,53,57,61]],"source":"auto","enabled":true,"range_mode":"full","range_start_deg":0.0,"range_end_deg":360.0,"n_samples":24,"weight_mode":"uniform","planarity_rms":0.0019622039600611482}

