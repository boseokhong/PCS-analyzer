# id label              x              y              z           G_ax       delta_pcs       delta_exp

[symmetry_averaging]
enabled = true
methyl_enabled = true
cf3_enabled = false
keep_original = false
mode = drop

[rotational_averaging]
enabled = true
detection_mode = auto
keep_reference = false
planarity_threshold = 0.1
phase = 4

[rotational_groups]
# One JSON object per configured torsional group
