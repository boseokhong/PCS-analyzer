{
  "schema_version": 1,
  "description": "Chemical-shift reference presets for NMR Workbench. Values are source-resolved; peer-reviewed Fulmer et al. 2010 values are preferred where that paper directly reports the deuterated-solvent signal, while the CIL 295 K solvent chart supplies requested solvents not covered there. Exchangeable signals are explicitly marked as poor choices for precision referencing.",
  "sources": {
    "cil_solvent_chart_295k": {
      "citation": "Cambridge Isotope Laboratories, Inc. NMR Solvent Data Chart.",
      "url": "https://www.csustan.edu/sites/default/files/2022-02/cambridge_isotope_labs_nmr_solvent_data.pdf",
      "publisher": "Cambridge Isotope Laboratories, Inc.",
      "year": null,
      "notes": "Branded CIL solvent chart. The chart states that 1H residual-solvent and 13C spectra were obtained on a Varian Gemini 200 at 295 K. The NMR solvents used for the spectra contained a maximum of 0.05% TMS (v/v) for 1H and 1.0% TMS (v/v) for 13C. Values can depend on solvent, concentration, and temperature."
    },
    "fulmer2010": {
      "citation": "Fulmer, G. R.; Miller, A. J. M.; Sherden, N. H.; Gottlieb, H. E.; Nudelman, A.; Stoltz, B. M.; Bercaw, J. E.; Goldberg, K. I. NMR Chemical Shifts of Trace Impurities: Common Laboratory Solvents, Organics, and Gases in Deuterated Solvents Relevant to the Organometallic Chemist. Organometallics 2010, 29, 2176-2179.",
      "doi": "10.1021/om100106e",
      "url": "https://pubs.acs.org/doi/10.1021/om100106e",
      "supporting_information_url": "https://scs.illinois.edu/system/files/inline-files/11BFulmer2010NMRSolventsSupplement.pdf",
      "publisher": "American Chemical Society",
      "year": 2010,
      "notes": "Peer-reviewed source. Supporting Information Table S1 gives 1H residual solvent signals and Table S2 gives 13C solvent signals for THF-d8, CD2Cl2, CDCl3, toluene-d8, C6D6, acetone-d6, DMSO-d6, CD3CN, CD3OD and D2O, among others."
    },
    "gottlieb1997": {
      "citation": "Gottlieb, H. E.; Kotlyar, V.; Nudelman, A. NMR Chemical Shifts of Common Laboratory Solvents as Trace Impurities. J. Org. Chem. 1997, 62, 7512-7515.",
      "doi": "10.1021/jo971176v",
      "url": "https://pubs.acs.org/doi/10.1021/jo971176v",
      "publisher": "American Chemical Society",
      "year": 1997,
      "notes": "Foundational peer-reviewed residual-solvent reference. Also documents the strong temperature dependence of HDO in D2O."
    },
    "iupac_harris2001": {
      "citation": "Harris, R. K.; Becker, E. D.; Cabral de Menezes, S. M.; Goodfellow, R.; Granger, P. NMR nomenclature. Nuclear spin properties and conventions for chemical shifts (IUPAC Recommendations 2001). Pure Appl. Chem. 2001, 73, 1795-1818.",
      "doi": "10.1351/pac200173111795",
      "url": "https://publications.iupac.org/pac/73/11/1795/index.html",
      "publisher": "IUPAC",
      "year": 2001,
      "notes": "IUPAC recommends a unified chemical-shift scale relative to the 1H resonance of TMS in dilute solution. Used here to support TMS = 0 ppm as the reference standard."
    },
    "tamu_cil_crosscheck": {
      "citation": "Texas A&M NMR Facility, OpenVnmrJ/Alma primer, CIL solvent chart reproduction.",
      "url": "https://nmr.tamu.edu/pdf/OVJ_Alma_Primer_rev1.pdf",
      "publisher": "Texas A&M University",
      "year": null,
      "notes": "Institutional cross-check reproducing CIL solvent-chart values for a broad set of deuterated solvents."
    }
  },
